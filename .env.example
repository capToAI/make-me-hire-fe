# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resume_db
# Host port mapping for PostgreSQL (5433 avoids collision if local 5432 is in use)
DB_PORT=5433
# Connection URL for backend container inside Docker network
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/resume_db
# Automatically synchronize TypeORM entities with database tables (recommended for dev)
DATABASE_SYNCHRONIZE=true
# Set to true only if connecting to an external SSL-enabled PostgreSQL instance
DATABASE_SSL=false

# ==========================================
# Backend Configuration (NestJS)
# ==========================================
BACKEND_PORT=3001
NODE_ENV=production
# OpenAI API key for resume parsing agent
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Chromium path for Puppeteer ATS vector PDF export
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
FRONTEND_PORT=3000
# Browser-accessible backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
# Internal Docker network URL for server-side Next.js / NextAuth requests
INTERNAL_API_URL=http://backend:3001

# NextAuth Authentication Configuration
AUTH_SECRET=your_super_secret_auth_key_here
AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
