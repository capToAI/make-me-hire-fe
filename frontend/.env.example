# NextAuth Authentication Configuration
# Generate a secret using: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=changeme_to_a_secure_random_secret_string_32chars

# Google OAuth Credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# NextAuth URL
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Backend NestJS REST API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001
